# --- Envoi du formulaire de contact (Resend) ---
# 1. Crée un compte gratuit sur https://resend.com
# 2. Vérifie le domaine groupesmartsolutions.fr (ajout de quelques enregistrements DNS)
# 3. Génère une clé API et colle-la ci-dessous
RESEND_API_KEY=

# Adresse qui reçoit les messages du formulaire (par défaut : contact@groupesmartsolutions.fr)
CONTACT_TO_EMAIL=contact@groupesmartsolutions.fr

# Expéditeur affiché (doit utiliser un domaine vérifié dans Resend)
CONTACT_FROM_EMAIL=Smart Solutions <contact@groupesmartsolutions.fr>

# --- Espace admin (/admin) ---
# Compte admin autorisé à se connecter au poste de pilotage.
ADMIN_EMAIL=admin@groupesmartsolutions.fr
ADMIN_PASSWORD=change-moi-mot-de-passe-fort
# Clé secrète pour signer les sessions. Génère-la avec :  openssl rand -base64 32
AUTH_SECRET=
